# OpenWRT UCI DHCP/DNS configuration
# Copy to /etc/config/dhcp on the device

config dnsmasq
	option domainneeded '1'
	option boguspriv '1'
	option filterwin2k '0'
	option localise_queries '1'
	option rebind_protection '1'
	option rebind_localhost '1'
	option local '/lan/'
	option domain 'lan'
	option expandhosts '1'
	option nonegcache '0'
	option cachesize '1000'
	option authoritative '1'
	option readethers '1'
	option leasefile '/tmp/dhcp.leases'
	option resolvfile '/tmp/resolv.conf.d/resolv.conf.auto'
	option localservice '1'
	option ednspacket_max '1232'
	# Force all DNS through local resolver (supports captive portal DNS intercept)
	option noresolv '0'

config dhcp 'lan'
	option interface 'lan'
	option start '100'
	option limit '150'
	option leasetime '1h'
	option dhcpv4 'server'
	option dhcpv6 'server'
	option ra 'server'
	# Push captive portal gateway as router
	list dhcp_option '3,192.168.10.1'
	list dhcp_option '6,192.168.10.1'

config dhcp 'wan'
	option interface 'wan'
	option ignore '1'

config odhcp6c
	option maindhcp '0'

# Captive portal DNS intercept:
# All DNS queries from unauthenticated clients are answered with the router IP
# This is managed dynamically by everywifi captive_portal.py
# The following is a static example for reference:
# config address
#   option interface 'lan'
#   option ip '192.168.10.1'
